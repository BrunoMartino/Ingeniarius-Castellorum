# --- obrigatórios ---
COOLIFY_URL=https://coolify.exemplo.com
# Token com read, read:sensitive, write, deploy. NUNCA root.
COOLIFY_API_TOKEN=
# Identidade lógica usada no audit log.
COOLIFY_USER=bruno

# --- opcionais ---
# stdio (default) | http
COOLIFY_MCP_TRANSPORT=stdio
# Só usado quando transport=http.
COOLIFY_MCP_HTTP_ADDR=:8788
# Bearer exigido dos clientes em modo http. Sem ele o binário recusa arrancar.
COOLIFY_MCP_HTTP_TOKEN=
# true (default): um status desconhecido bloqueia mutações de config.
COOLIFY_MCP_STRICT_ONAIR=true
# false desliga o grupo run_cli inteiro.
COOLIFY_MCP_ALLOW_CLI=true
# Reservado; chaves SSH privadas continuam fora do catálogo.
COOLIFY_MCP_ALLOW_PRIVATE_KEYS=false
COOLIFY_MCP_AUDIT_PATH=~/.coolify-mcp/audit.jsonl
COOLIFY_MCP_TIMEOUT=30s
